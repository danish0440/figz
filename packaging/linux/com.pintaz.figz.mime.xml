<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definitions for FigZ's own document type and for Sketch files, which
     FigZ opens (SVG, PNG and JPEG are already in the system database). Installed to /usr/share/mime/packages/ (update-mime-database runs on
     install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-figz">
    <comment>FigZ document</comment>
    <icon name="com.pintaz.figz"/>
    <glob pattern="*.figz"/>
  </mime-type>
  <!-- Sketch 48 and newer save a zip of JSON. -->
  <mime-type type="application/x-sketch">
    <comment>Sketch document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.sketch"/>
  </mime-type>
</mime-info>
