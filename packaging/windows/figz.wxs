<?xml version="1.0" encoding="utf-8"?>
<!--
  FigZ MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build figz.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc figz.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\FigZ by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch FigZ" box. Installs a Start Menu shortcut, makes
  FigZ the owner of `.figz`, and offers it under "Open with" for SVG, PNG and JPEG
  (without taking over the user's default app for them), plus figz-cli when HasCli=1.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed for FigZ forever (generated once; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="FigZ"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="D3088A2C-93D8-5304-A6FF-9E14F950588F"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="FigZ interface design and prototyping tool" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of FigZ is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="FigzIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FigzIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danish0440/figz" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/danish0440/figz" />
    <Property Id="ARPHELPLINK" Value="https://github.com/danish0440/figz/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FigZ" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by FigzApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\FigZ" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="FigZ" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif ?>
      <ComponentGroupRef Id="FigzFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFigz"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through figz.en-us.wxl. -->
    <Property Id="FigzVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="FigZ $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FigZ" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#FigzExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchFigz" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif ?>
    <ComponentGroup Id="FigzFiles" Directory="INSTALLFOLDER">
      <Component Id="FigzApp" Guid="FC4E5186-BA51-5330-939B-BA616EAC4B96">
        <File Id="FigzNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="FigzExe" Source="$(var.BinDir)\figz.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FigZ"
              Description="FigZ interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FigzIcon.exe" IconIndex="0" />
        </File>

        <!-- .figz: FigZ's own format; FigZ is its default app. -->
        <ProgId Id="Figz.Document" Description="FigZ Document" Icon="FigzExe" IconIndex="0">
          <Extension Id="figz" ContentType="application/x-figz">
            <Verb Id="open" Command="Open" TargetFile="FigzExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Figz.Image" Description="Image" Icon="FigzExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Figz.Image\shell\open\command" Value="&quot;[#FigzExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.svg\OpenWithProgids" Name="Figz.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="Figz.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="Figz.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Figz.Image" Value="" Type="string" />
        <!-- Sketch files (opened as a copy; FigZ doesn't save .sketch): "Open with" only too. -->
        <ProgId Id="Figz.Sketch" Description="Sketch Document" Icon="FigzExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Figz.Sketch\shell\open\command" Value="&quot;[#FigzExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.sketch\OpenWithProgids" Name="Figz.Sketch" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "figz"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\figz.exe" Name="FriendlyAppName" Value="FigZ" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\figz.exe\shell\open\command" Value="&quot;[#FigzExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\figz.exe\SupportedTypes" Name=".figz" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\figz.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\figz.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\figz.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\figz.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\figz.exe\SupportedTypes" Name=".sketch" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\figz.exe" Value="[#FigzExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FigZ" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="FigzCli">
        <File Id="FigzCliExe" Source="$(var.BinDir)\figz-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
